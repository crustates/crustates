[Unit]
Description=Crustates node agent
Documentation=https://github.com/crustates/crustates
Wants=network-online.target
After=network-online.target crust-api.service

[Service]
Type=exec
# Defaults from the image, overrides from /etc (later files win).
EnvironmentFile=/usr/lib/crustates/crust-agent.env
EnvironmentFile=-/etc/crustates/crust-agent.env
ExecStart=/usr/bin/crust-agent
Restart=on-failure
# Root, with little sandboxing: the agent stages and rolls back OS images
# (bootc writes /sysroot and the boot loader), reboots, and queues Secure Boot
# keys (EFI variables). Engines will need more of the machine later.
StateDirectory=crust-agent
CacheDirectory=crust-agent
# cosign keeps the Sigstore trust root here.
Environment=HOME=/var/lib/crust-agent TUF_ROOT=/var/cache/crust-agent/sigstore
UMask=0077
ProtectHome=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
