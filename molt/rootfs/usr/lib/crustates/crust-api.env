# Defaults for crust-api. Override them in /etc/crustates/crust-api.env.
# Every setting is listed in crates/crust-api/src/config.rs.
CRUST_LISTEN=[::]:8080
# Agents on this machine only; remote agents need mTLS first.
CRUST_AGENT_LISTEN=127.0.0.1:8081
CRUST_DATABASE=/var/lib/crustates/crust.db
CRUST_HEARTBEAT_TIMEOUT_SECS=15
# The admin token's hash; crust-firstboot.service writes it on the first boot.
CRUST_ADMIN_TOKEN_FILE=/var/lib/crustates/secrets/admin-token
# The recovery PIN's hash, for the console's risky actions (ADR 0018).
CRUST_RECOVERY_PIN_FILE=/var/lib/crustates/secrets/recovery-pin
# The local console's way in: root only (ADR 0018).
CRUST_LOCAL_SOCKET=/run/crustates/api.sock
