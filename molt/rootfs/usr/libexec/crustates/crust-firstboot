#!/bin/bash
# Makes the admin token and the recovery PIN when they are missing. Stores
# only their argon2id hashes, where the API can read but not change them,
# and leaves the secrets for the console to show once: in
# /run/crustates/firstboot.json, root only, gone after a reboot (ADR 0015,
# ADR 0018). Runs at every boot: hashes the installer wrote get their owner
# and mode here, because the crustates group exists only from the first boot.
set -euo pipefail
umask 077

# Normally crust-api.service made the state directory already. If it did not
# start, make it as it would, or its first start hands everything in it,
# secrets included, to the crustates user.
[ -e /var/lib/crustates ] || install -d -m 0750 -o crustates -g crustates /var/lib/crustates
secrets=/var/lib/crustates/secrets
install -d -m 0750 -o root -g crustates "$secrets"
token="" pin=""
if [ ! -e "$secrets/admin-token" ]; then
    token=$(CRUST_ADMIN_TOKEN_FILE="$secrets/admin-token" /usr/bin/crust-api new-admin-token)
fi
# Machines installed before the console have a token but no PIN yet.
if [ ! -e "$secrets/recovery-pin" ]; then
    pin=$(CRUST_RECOVERY_PIN_FILE="$secrets/recovery-pin" /usr/bin/crust-api new-recovery-pin)
fi
for file in admin-token recovery-pin; do
    chown root:crustates "$secrets/$file"
    chmod 0640 "$secrets/$file"
done

if [ -z "$token$pin" ]; then
    exit 0
fi
install -d -m 0770 -o root -g crustates /run/crustates
jq -n --arg token "$token" --arg pin "$pin" '{token: $token, pin: $pin}' >/run/crustates/firstboot.json
echo "made the first-boot secrets; the console shows them until someone confirms them or the machine reboots"
