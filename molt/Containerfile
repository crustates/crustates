# Molt: the Crustates OS image (ADR 0002). Build with `cargo xtask molt build`
# from the repository root, which is the build context.
#
# Targets:
#   molt           the production image
#   molt-test      molt plus crust-selftest.service, for boot tests only; it
#                  updates from the test registry without signature checks
#   molt-test-bad  molt-test whose health check fails, to test rollbacks

# Fedora 45 bootc, pinned by digest; Renovate bumps it. A new digest that
# brings a new kernel fails the kernel.lock check below until the lock is
# bumped in a deliberate PR.
ARG BASE=quay.io/fedora/fedora-bootc:45@sha256:8076cf4ff9d1fda1fcc759c021b8c317fe2b687ae51259e45917c95fed3308bc

# Builds the release binaries on the same base, so they link against the
# same glibc as the image.
FROM ${BASE} AS builder
RUN dnf -y install --setopt=install_weak_deps=False gcc rustup && dnf clean all
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN rustup-init -y --profile minimal --default-toolchain none --no-modify-path
WORKDIR /src
COPY rust-toolchain.toml ./
# Installs the toolchain rust-toolchain.toml names, in its own cached layer.
RUN rustup show active-toolchain || rustup toolchain install
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY crates crates
COPY xtask xtask
RUN --mount=type=cache,target=/opt/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p crust-api -p crust-agent -p crust-cli \
    && install -D -m 0755 -t /out/usr/bin \
        target/release/crust-api target/release/crust-agent target/release/crust

# cosign, for the agent's image signature checks (ADR 0016). Fedora does not
# package it, so this is the release binary, pinned by version and checksum.
FROM ${BASE} AS cosign
ARG COSIGN_VERSION=3.1.4
RUN case "$(uname -m)" in \
        x86_64) arch=amd64 sum=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa ;; \
        aarch64) arch=arm64 sum=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2 ;; \
        *) echo "no cosign for $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -sSfL -o /tmp/cosign \
        "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${arch}" \
    && echo "${sum}  /tmp/cosign" | sha256sum --check --quiet \
    && install -D -m 0755 /tmp/cosign /out/usr/libexec/crustates/cosign

# The base image plus the kernel-devel that matches kernel.lock, for building
# out-of-tree modules. See molt/kmods/README.md.
FROM ${BASE} AS kmod-base
COPY molt/kernel.lock /kmods/kernel.lock
RUN kernel=$(cat /kmods/kernel.lock).$(uname -m) \
    && version=${kernel%%-*} release=${kernel#*-} && release=${release%.*} \
    && pkgs="gcc make elfutils-libelf-devel libuuid-devel libblkid-devel libtirpc-devel openssl-devel zlib-ng-compat-devel libaio-devel libattr-devel systemd-devel" \
    && { dnf -y install --setopt=install_weak_deps=False "kernel-devel-${kernel}" $pkgs \
        || dnf -y install --setopt=install_weak_deps=False $pkgs \
            "https://kojipkgs.fedoraproject.org/packages/kernel/${version}/${release}/$(uname -m)/kernel-devel-${kernel}.rpm"; } \
    && dnf clean all
COPY molt/kmods/sign.sh /kmods/sign.sh

FROM kmod-base AS kmod-zfs
COPY molt/kmods/zfs/ /kmods/zfs/
RUN /kmods/zfs/build.sh
RUN --mount=type=secret,id=module-signing-key \
    --mount=type=secret,id=module-signing-cert \
    /kmods/sign.sh

FROM ${BASE} AS molt
RUN --mount=type=bind,source=molt/kernel.lock,target=/run/kernel.lock \
    kernel=$(rpm -q --qf '%{VERSION}-%{RELEASE}\n' kernel) \
    && want=$(cat /run/kernel.lock) \
    && if [ "$kernel" != "$want" ]; then \
        echo "kernel $kernel differs from molt/kernel.lock ($want); bump the lock in its own PR" >&2; \
        exit 1; \
    fi
# No SSH: everything goes through the API. greenboot runs the health checks
# that roll back a new image (ADR 0016).
RUN dnf -y remove openssh-server \
    && dnf -y install --setopt=install_weak_deps=False greenboot \
    && dnf clean all \
    && rm -rf /run/dnf /var/cache/libdnf5 /var/log/dnf5.log* /var/lib/dnf
COPY --from=builder /out/ /
COPY --from=cosign /out/ /
# ZFS modules (signed) and userland. Btrfs is in the kernel, btrfs-progs in
# the base image.
COPY --from=kmod-zfs /out/ /
RUN depmod -a "$(ls /usr/lib/modules)"
COPY molt/rootfs/ /
# Crustates decides when Molt updates (the agent), not bootc's own timer.
RUN systemctl enable crust-api.service crust-agent.service crust-firstboot.service nftables.service \
        greenboot-healthcheck.service greenboot-set-rollback-trigger.service crust-boot-trial.service \
    && systemctl mask bootc-fetch-apply-updates.timer
# Late, so a new version reuses every layer above.
ARG VERSION
LABEL org.opencontainers.image.version=${VERSION}
# printf, not a heredoc: RUN heredocs need buildah 1.35+, and the CI runners
# have podman 4.9 (buildah 1.33).
RUN test -n "${VERSION}" \
    && printf 'VARIANT="Crustates Molt"\nVARIANT_ID=molt\nIMAGE_ID=molt\nIMAGE_VERSION=%s\n' "${VERSION}" \
        >>/usr/lib/os-release
RUN bootc container lint

FROM molt AS molt-test
COPY molt/test/crust-selftest.sh /usr/libexec/crustates/crust-selftest
COPY molt/test/crust-selftest.service /usr/lib/systemd/system/
COPY molt/test/1*-serial-console*.toml /usr/lib/bootc/kargs.d/
# Updates come from the local registry of `cargo xtask molt test`, unsigned.
COPY molt/test/molt.toml /usr/lib/crustates/molt.toml
COPY molt/test/50-crust-test-registry.conf /etc/containers/registries.conf.d/
RUN systemctl enable crust-selftest.service
RUN bootc container lint

FROM molt-test AS molt-test-bad
RUN touch /usr/lib/crustates/test-fail-health
